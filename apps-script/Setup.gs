function setupProductionERP(){const p=PropertiesService.getScriptProperties();p.setProperty('MASTER_SPREADSHEET_ID',ERP.DB_ID);if(!p.getProperty('API_SECRET'))p.setProperty('API_SECRET',Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));if(!p.getProperty('PIN_SALT'))p.setProperty('PIN_SALT',Utilities.getUuid());SpreadsheetApp.getUi().alert('Production ERP backend configured.\n\nAPI Secret:\n'+p.getProperty('API_SECRET')+'\n\nKeep it private and add it to Cloudflare as GAS_API_SECRET.')}
function createOrResetAdmin(){const ui=SpreadsheetApp.getUi(),id=ui.prompt('Admin User ID').getResponseText().trim().toUpperCase();if(!id)return;const name=ui.prompt('Admin Name').getResponseText().trim();const pin=ui.prompt('Admin PIN (4-8 digits)').getResponseText().trim();if(!/^\d{4,8}$/.test(pin)){ui.alert('Invalid PIN.');return}const s=sh_(ERP.S.USERS),f=findUser_(id),now=new Date(),row=[id,name,hashPin_(id,pin),'ADMIN',true,true,true,true,true,true,true,true,0,'','',f?(f.user.CREATED_AT||now):now,now];if(f)s.getRange(f.row,1,1,row.length).setValues([row]);else s.appendRow(row);ui.alert('Admin ready: '+id)}
function showApiSecret(){SpreadsheetApp.getUi().alert(PropertiesService.getScriptProperties().getProperty('API_SECRET')||'Run setupProductionERP first.')}
function onOpen(){SpreadsheetApp.getUi().createMenu('RRR Production ERP').addItem('Setup Backend','setupProductionERP').addItem('Create / Reset Admin','createOrResetAdmin').addItem('Show API Secret','showApiSecret').addToUi()}
